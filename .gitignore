# Report documents (Word files), kept local
docs/*.docx

# Python cache
__pycache__/
*.pyc
*.pyo

# FAISS index - large binary files
data/faiss_index/

# VS Code settings
.vscode/

# OS files
.DS_Store
Thumbs.db

